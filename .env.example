# Copy to .env and fill in. .env is gitignored — never commit real values.

# TODO: verify this is the correct externally-reachable Keycloak token endpoint.
# Every KEYCLOAK_TOKEN_URL seen in ebas-portal-web's config uses an internal
# cluster hostname (thredds.pkub.nilu.no / thredds.dkub.nilu.no) — this is a
# guess by URL pattern against the external host, not a confirmed endpoint.
KEYCLOAK_TOKEN_URL=https://thredds.nilu.no/auth/realms/ebas/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=ebas-cli

# Optional: only needed for non-interactive notebook runs.
# By default the notebook prompts for these via getpass instead.
# EBAS_USERNAME=
# EBAS_PASSWORD=
